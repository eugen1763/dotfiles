* {
    font: "JetBrains Mono 11";
    background-color: transparent;
    text-color: #bfe9f5;
}
window { width: 900px; location: center; anchor: center; border: 2px; border-color: #2de2ff; border-radius: 12px; padding: 20px; background-color: #0a1826; }
mainbox { children: [ inputbar, message, listview ]; spacing: 14px; }
inputbar { children: [ prompt, entry ]; spacing: 14px; padding: 6px; }
prompt { text-color: #2de2ff; }
entry { placeholder: "Find a theme…"; }
message { padding: 0px 6px; }
textbox { text-color: #5b7a8a; }
listview { columns: 3; lines: 2; fixed-height: true; scrollbar: true; spacing: 12px; }
element { orientation: vertical; spacing: 8px; padding: 12px; border: 2px; border-color: #0a1826; border-radius: 8px; }
element-icon { size: 210px; horizontal-align: 0.5; }
element-text { horizontal-align: 0.5; }
element selected.normal, element selected.active { background-color: #0e2233; border-color: #2de2ff; }
element normal.active { text-color: #2de2ff; }
