* {
    font: "JetBrains Mono 11";
    background-color: transparent;
    text-color: #f8e2d6;
}
window { width: 900px; location: center; anchor: center; border: 2px; border-color: #eca28c; border-radius: 12px; padding: 20px; background-color: #321e24; }
mainbox { children: [ inputbar, message, listview ]; spacing: 14px; }
inputbar { children: [ prompt, entry ]; spacing: 14px; padding: 6px; }
prompt { text-color: #eca28c; }
entry { placeholder: "Find a theme…"; }
message { padding: 0px 6px; }
textbox { text-color: #c09b95; }
listview { columns: 3; lines: 2; fixed-height: true; scrollbar: true; spacing: 12px; }
element { orientation: vertical; spacing: 8px; padding: 12px; border: 2px; border-color: #321e24; border-radius: 8px; }
element-icon { size: 210px; horizontal-align: 0.5; }
element-text { horizontal-align: 0.5; }
element selected.normal, element selected.active { background-color: #442932; border-color: #eca28c; }
element normal.active { text-color: #eca28c; }
