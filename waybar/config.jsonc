// -*- mode: jsonc -*-
// Three-island layout:
//   - "main"   bar (all monitors): LEFT island + RIGHT island
//   - "center" bar (DP-6 only, the main screen / workspace 2): MIDDLE island
// Shared module definitions live in modules.jsonc (included by both bars).
[
    {
        "name": "main",
        "layer": "top",
        "height": 36,
        "spacing": 4,
        "margin-top": 6,
        "margin-left": 10,
        "margin-right": 10,
        "include": ["$HOME/.config/waybar/modules.jsonc"],
        "modules-left": [
            "hyprland/workspaces",
            "custom/media"
        ],
        "modules-center": [],
        "modules-right": [
            "mpd",
            "idle_inhibitor",
            "pulseaudio",
            "network",
            "disk",
            "battery",
            "cpu",
            "memory"
        ]
    },
    {
        "name": "center",
        "output": ["DP-6"],
        "layer": "top",
        "exclusive": false,
        "height": 36,
        "spacing": 4,
        // align with the main islands: centre margin-top must equal -height
        // (cancels the main bar's height + its own margin-top offset).
        "margin-top": -36,
        "include": ["$HOME/.config/waybar/modules.jsonc"],
        "modules-left": [],
        "modules-center": [
            "clock"
        ],
        "modules-right": []
    }
]
