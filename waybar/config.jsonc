// -*- mode: jsonc -*-
// Three-island layout:
//   - "main"   bar (all monitors): LEFT island + RIGHT island
//   - "center" bar (DP-6 only, the main screen / workspace 2): MIDDLE island
// Shared module definitions live in modules.jsonc (included by both bars).
[
    {
        "name": "main",
        "layer": "top",
        "height": 26,
        "spacing": 4,
        "margin-top": 6,
        "margin-left": 10,
        "margin-right": 10,
        "include": ["$HOME/.config/waybar/modules.jsonc"],
        "modules-left": [
            "hyprland/workspaces",
            "custom/media"
        ],
        "modules-center": [],
        "modules-right": [
            "mpd",
            "inhibitor",
            "pulseaudio",
            "custom/vpn",
            "network",
            "disk",
            "battery",
            "cpu",
            "memory",
            "clock"
        ]
    },
    {
        "name": "center",
        "output": ["DP-6"],
        "layer": "top",
        "exclusive": false,
        "height": 26,
        // Shrink this overlay surface to a centred band via large side margins,
        // so it ONLY covers the clock. A full-width transparent bar would sit on
        // top of the main bar and swallow clicks meant for the left/right islands.
        // DP-6 is 2560 wide: (2560 - 500) / 2 = 1030 margin each side -> 500px band.
        "margin-left": 1030,
        "margin-right": 1030,
        "spacing": 4,
        // align with the main islands: centre margin-top must equal -height
        // (cancels the main bar's height + its own margin-top offset).
        "margin-top": -26,
        "include": ["$HOME/.config/waybar/modules.jsonc"],
        "modules-left": [],
        "modules-center": [
            "clock"
        ],
        "modules-right": []
    }
]
